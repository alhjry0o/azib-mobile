# ============================================================
# AZIB — Public Environment Variables (safe to ship to client)
# ============================================================
# يقرأها Expo وقت البناء ويُضمّنها في الـbundle. آمنة للنشر.
# ممنوع تماماً هنا: أي سر، service_role، مفاتيح دفع، بيانات شخصية.
# ============================================================
# لا تُرفع .env / .env.local / .env.*.local إلى Git.
# هذه المتغيرات PUBLIC (تبدأ بـ EXPO_PUBLIC_) — أي أحد يفكّ الـbundle يراها.
# الحماية الحقيقية في RLS وقاعدة البيانات، لا في إخفاء هذه القيم.
# ============================================================

# development | staging | production
EXPO_PUBLIC_APP_MODE=development

# local | dev | staging | prod — تُعرض في شاشة Diagnostics فقط
EXPO_PUBLIC_ENV=local

# ============================================================
# Supabase (PUBLIC — يُملأ في P18 عند إنشاء المشروع)
# anon key آمن للنشر، وRLS في القاعدة هي الحارس.
# لا تضع service_role هنا أبداً.
# ============================================================
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
